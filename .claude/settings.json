{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard_bash_policy.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard_single_source.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard_source_length.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/guard_doc_size.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
